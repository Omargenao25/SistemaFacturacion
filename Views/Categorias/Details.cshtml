@model SistemaFacturacion.Models.Categoria
@{
    ViewData["Title"] = "Detalle de categoría";
}

<div class="nx-crud-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Categorias / Detalle</div>
            <h1 class="page-title">Detalle de categoría</h1>
            <p class="page-subtitle">Consulta la información registrada en el sistema.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Volver a categorías
        </a>
    </div>
    <div class="nx-crud-shell">
        <section class="nx-panel" aria-labelledby="nx-detail-title">
            <div class="nx-panel-header">
                <div class="nx-crud-heading">
                    <span class="nx-crud-heading-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="nx-panel-title" id="nx-detail-title">@Model.Nombre</h2>
                        <p class="nx-panel-subtitle">Información del registro</p>
                    </div>
                </div>
                
            </div>

            

            <dl class="nx-detail-grid">
                <div class="nx-detail-row"><dt>Nombre</dt><dd>@Model.Nombre</dd></div>
                    <div class="nx-detail-row"><dt>Descripción</dt><dd>@(Model.Descripcion ?? "Sin descripción")</dd></div>
            </dl>

            <div class="nx-detail-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
                <a asp-action="Edit" asp-route-id="@Model.IdCategoria" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Editar categoría
                </a>
            </div>
        </section>
        <aside class="nx-crud-sidebar">
            <span class="nx-crud-sidebar-icon">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
            </span>
            <h3>Información del registro</h3>
            <p>Desde esta pantalla puedes revisar el registro y editarlo si necesitas actualizar sus datos.</p>
        </aside>
    </div>
</div>
