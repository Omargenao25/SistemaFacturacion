@model SistemaFacturacion.Models.Categoria
@{
    ViewData["Title"] = "Editar categoría";
}
<div class="nx-crud-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Categorías</div>
            <h1 class="page-title">Editar categoría</h1>
            <p class="page-subtitle">Modifica el nombre y la descripción de esta categoría.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Volver a categorías</a>
    </div>

    <div class="nx-crud-shell">
        <section class="nx-panel" aria-labelledby="nx-crud-heading">
            <div class="nx-panel-header">
                <div class="nx-crud-heading">
                    <span class="nx-crud-heading-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="nx-panel-title" id="nx-crud-heading">Información de la categoría</h2>
                        <p class="nx-panel-subtitle">Los campos con * son obligatorios.</p>
                    </div>
                </div>
            </div>
            <form asp-action="Edit" method="post" class="nx-crud-form">
                <input type="hidden" asp-for="IdCategoria" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-4">
                    <div class="col-12"><label asp-for="Nombre" class="form-label">Nombre de categoría <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Nombre" class="form-control" type="text" maxlength="60" placeholder="Ej. Electrónica" required /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="150" placeholder="¿Qué artículos pertenecen a esta categoría?"></textarea><span asp-validation-for="Descripcion" class="text-danger small"></span></div>
                </div>
                <div class="nx-crud-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i> Guardar cambios</button>
                </div>
            </form>
        </section>
        <aside class="nx-crud-sidebar">
            <span class="nx-crud-sidebar-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
            <h3>Consejo de Nexora</h3>
            <p>Usa categorías claras y breves; así será más fácil mantener el inventario organizado.</p>
        </aside>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
