@model SistemaFacturacion.Models.Cliente
@{
    ViewData["Title"] = "Eliminar cliente";
}

<div class="nx-crud-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Clientes / Eliminar</div>
            <h1 class="page-title">Eliminar cliente</h1>
            <p class="page-subtitle">Verifica los datos antes de confirmar la eliminación.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Volver a clientes
        </a>
    </div>
    <div class="nx-crud-shell">
        <section class="nx-panel" aria-labelledby="nx-detail-title">
            <div class="nx-panel-header">
                <div class="nx-crud-heading">
                    <span class="nx-crud-heading-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="nx-panel-title" id="nx-detail-title">@(Model.Nombre + " " + Model.Apellido)</h2>
                        <p class="nx-panel-subtitle">Información del registro</p>
                    </div>
                </div>
                <span class="nx-status danger">Pendiente de eliminar</span>
            </div>

            <div class="nx-delete-warning" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div>
                    <strong>¿Deseas eliminar este registro?</strong>
                    <p>Esta acción intenta borrar el registro de la base de datos. Antes de eliminar un cliente con facturas, verifica las relaciones de la base de datos y la conservación del historial.</p>
                </div>
            </div>

            <dl class="nx-detail-grid">
                <div class="nx-detail-row"><dt>Nombre</dt><dd>@Model.Nombre</dd></div>
                    <div class="nx-detail-row"><dt>Apellido</dt><dd>@Model.Apellido</dd></div>
                    <div class="nx-detail-row"><dt>Teléfono</dt><dd>@(Model.Telefono ?? "No registrado")</dd></div>
                    <div class="nx-detail-row"><dt>Correo</dt><dd>@(Model.Correo ?? "No registrado")</dd></div>
                    <div class="nx-detail-row"><dt>Dirección</dt><dd>@(Model.Direccion ?? "No registrada")</dd></div>
                    <div class="nx-detail-row"><dt>Identificación fiscal</dt><dd>@(Model.IdentificacionFiscal ?? "No registrada")</dd></div>
            </dl>

            <div class="nx-detail-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <form asp-action="Delete" asp-route-id="@Model.IdCliente" method="post" class="nx-delete-form">
                    <input type="hidden" asp-for="IdCliente" />
                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirmas la eliminación de este registro?');">
                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i> Confirmar eliminación
                    </button>
                </form>
            </div>
        </section>
        <aside class="nx-crud-sidebar">
            <span class="nx-crud-sidebar-icon">
                <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
            </span>
            <h3>Antes de eliminar</h3>
            <p>Antes de eliminar un cliente con facturas, verifica las relaciones de la base de datos y la conservación del historial.</p>
        </aside>
    </div>
</div>
