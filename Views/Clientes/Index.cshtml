@model IEnumerable<SistemaFacturacion.Models.Cliente>
@{ var nxRutaEmpresaSlug = ViewContext.RouteData.Values["empresaSlug"]?.ToString(); }
@{ ViewData["Title"] = "Clientes"; }
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>@mensaje</div>
}
<div class="page-intro">
    <div><div class="page-eyebrow">Nexora / Gestión</div><h1 class="page-title">Clientes</h1><p class="page-subtitle">Consulta y administra la información de tus clientes.</p></div>
    <a asp-action="Create" asp-route-empresaSlug="@nxRutaEmpresaSlug" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Nuevo cliente</a>
</div>
<section class="nx-panel">
    <div class="nx-panel-header"><h2 class="nx-panel-title">Directorio de clientes</h2><span class="text-muted small">@Model.Count() registros</span></div>
    @if(!Model.Any()) {
        <div class="nx-empty"><i class="bi bi-people"></i>No hay clientes registrados. Agrega el primero.</div>
    } else {
        <div class="table-responsive"><table class="table table-hover nx-table">
            <thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Dirección</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach(var item in Model) {
                <tr><td class="fw-semibold">@item.Nombre @item.Apellido</td><td>@(item.Telefono ?? "—")</td><td>@(item.Correo ?? "—")</td><td>@(item.Direccion ?? "—")</td><td>
                    <a class="nx-list-action" asp-action="Details" asp-route-empresaSlug="@nxRutaEmpresaSlug" asp-route-id="@item.IdCliente">Ver</a>
                    <a class="nx-list-action" asp-action="Edit" asp-route-empresaSlug="@nxRutaEmpresaSlug" asp-route-id="@item.IdCliente">Editar</a>
                    <a class="nx-list-action text-danger" asp-action="Delete" asp-route-empresaSlug="@nxRutaEmpresaSlug" asp-route-id="@item.IdCliente">Eliminar</a>
                </td></tr>
            }
            </tbody>
        </table></div>
    }
</section>