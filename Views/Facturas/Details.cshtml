@model SistemaFacturacion.Models.Factura
@using SistemaFacturacion.Models

@{
    ViewData["Title"] = "Detalle de Factura";

    var pago = ViewBag.Pago as Pago;
}

<div class="container mt-4">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success no-print">
            @TempData["Mensaje"]
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>
                Factura @Model.NumeroFactura
            </h2>

            <small class="text-muted">
                Fecha: @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>


        <div class="no-print">

            <a asp-action="Index"
               class="btn btn-secondary">

                Historial

            </a>


            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">

                Imprimir Factura

            </button>


            @if (Model.Estado == "Emitida")
            {
                <form asp-action="Anular"
                      asp-route-id="@Model.IdFactura"
                      method="post"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('¿Está seguro de que desea anular esta factura? El inventario será restaurado.');">

                        Anular Factura

                    </button>

                </form>
            }

        </div>

    </div>


    @if (Model.Estado == "Anulada")
    {
        <div class="alert alert-danger text-center fw-bold">
            FACTURA ANULADA
        </div>
    }


    <hr />


    <div class="row mb-4">

        <!-- DATOS DEL CLIENTE -->
        <div class="col-md-6">

            <h5>Cliente</h5>

            <p class="mb-1">
                <strong>
                    @Model.Cliente?.Nombre
                    @Model.Cliente?.Apellido
                </strong>
            </p>

            <p class="mb-1">
                <strong>Teléfono:</strong>
                @(Model.Cliente?.Telefono ?? "No registrado")
            </p>

            <p class="mb-1">
                <strong>Correo:</strong>
                @(Model.Cliente?.Correo ?? "No registrado")
            </p>

            <p class="mb-1">
                <strong>Dirección:</strong>
                @(Model.Cliente?.Direccion ?? "No registrada")
            </p>

        </div>


        <!-- DATOS DE LA FACTURA -->
        <div class="col-md-6">

            <h5>Información de factura</h5>

            <p class="mb-1">

                <strong>Número:</strong>
                @Model.NumeroFactura

            </p>


            <p class="mb-1">

                <strong>Estado:</strong>

                @if (Model.Estado == "Emitida")
                {
                    <span class="badge bg-success">
                        Emitida
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Anulada
                    </span>
                }

            </p>


            <p class="mb-1">

                <strong>Método de pago:</strong>

                @(pago?.MetodoPago ?? "No registrado")

            </p>


            @if (pago != null)
            {
                <p class="mb-1">

                    <strong>Monto pagado:</strong>

                    RD$ @pago.Monto.ToString("N2")

                </p>
            }

        </div>

    </div>


    <!-- DETALLE DE PRODUCTOS -->
    <div class="table-responsive">

        <table class="table table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Subtotal</th>
                </tr>

            </thead>


            <tbody>

                @foreach (var detalle in Model.Detalles)
                {
                    <tr>

                        <td>
                            @detalle.Producto?.Nombre
                        </td>

                        <td class="text-center">
                            @detalle.Cantidad
                        </td>

                        <td class="text-end">
                            RD$ @detalle.Precio.ToString("N2")
                        </td>

                        <td class="text-end">
                            RD$ @detalle.Subtotal.ToString("N2")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- TOTALES -->
    <div class="row justify-content-end mt-3">

        <div class="col-md-5">

            <table class="table">

                <tr>

                    <th>
                        Subtotal
                    </th>

                    <td class="text-end">
                        RD$ @Model.Subtotal.ToString("N2")
                    </td>

                </tr>


                <tr>

                    <th>
                        ITBIS
                    </th>

                    <td class="text-end">
                        RD$ @Model.Impuesto.ToString("N2")
                    </td>

                </tr>


                <tr>

                    <th>
                        Descuento
                    </th>

                    <td class="text-end">
                        RD$ @Model.Descuento.ToString("N2")
                    </td>

                </tr>


                <tr class="table-success">

                    <th>
                        TOTAL
                    </th>

                    <td class="text-end fw-bold fs-5">
                        RD$ @Model.Total.ToString("N2")
                    </td>

                </tr>

            </table>

        </div>

    </div>


    <div class="text-center mt-5 text-muted">
        <small>
            Gracias por su compra.
        </small>
    </div>

</div>


<style>

    @@media print {

        .no-print,
        header,
        footer,
        nav {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .container {
            max-width: 100% !important;
            width: 100% !important;
        }

        .table-dark {
            color: black !important;
            background: white !important;
        }

        .table-dark th {
            color: black !important;
            background: white !important;
            border: 1px solid black !important;
        }

        .alert-danger {
            border: 2px solid black;
            color: black;
            background: white;
        }

    }

</style>