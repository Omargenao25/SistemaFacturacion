@model SistemaFacturacion.Models.Factura
@using SistemaFacturacion.Models
@{
    ViewData["Title"] = "Detalle de factura";
    var pago = ViewBag.Pago as Pago;
    var anulada = Model.Estado == "Anulada";
    var puedeAnular = ViewBag.PuedeAnular is bool permitido && permitido;
    var fechaLimiteAnulacion = ViewBag.FechaLimiteAnulacion is DateTime limite
        ? limite : Model.Fecha.AddDays(7);
    var nombreCliente = Model.Cliente == null
        ? "Cliente no disponible"
        : $"{Model.Cliente.Nombre} {Model.Cliente.Apellido}";
    var unidadesPorRestaurar = Model.Detalles.Sum(detalle => detalle.Cantidad);
    var lineasFactura = Model.Detalles.Count;
}

<div class="nx-details-page">
    <div class="page-intro no-print">
        <div>
            <div class="page-eyebrow">Nexora / Facturación</div>
            <h1 class="page-title">Detalle de factura</h1>
            <p class="page-subtitle">Consulta, imprime o administra el comprobante de esta venta.</p>
        </div>
        <div class="nx-receipt-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Historial
            </a>
            <a asp-controller="Posventa" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Posventa
            </a>
            <button type="button" class="btn btn-primary" onclick="window.print()">
                <i class="bi bi-printer me-1" aria-hidden="true"></i> Imprimir
            </button>
            @if (puedeAnular)
            {
                <button type="button" class="btn btn-outline-danger nx-void-trigger"
                        data-bs-toggle="modal" data-bs-target="#nxVoidInvoiceModal"
                        aria-haspopup="dialog">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Anular factura
                </button>
            }
            else if (!anulada)
            {
                <span class="nx-receipt-expired" title="El plazo interno de anulación ha finalizado">
                    <i class="bi bi-lock me-1" aria-hidden="true"></i> Anulación fuera de plazo
                </span>
            }
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success no-print" role="status">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning no-print" role="alert">
            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@TempData["Error"]
        </div>
    }

    @if (!anulada && !puedeAnular)
    {
        <div class="alert alert-info no-print" role="status">
            El plazo interno de 7 días para anular terminó el
            <strong>@fechaLimiteAnulacion.ToString("dd/MM/yyyy HH:mm")</strong>.
            Las devoluciones y garantías se gestionan por separado.
        </div>
    }

    <article class="nx-receipt" aria-label="Comprobante de venta @Model.NumeroFactura">
        <div class="nx-receipt-topline"></div>
        <div class="nx-receipt-inner">
            <div class="nx-receipt-header">
                <div class="nx-receipt-company">
                    <span class="nx-receipt-brand-mark"><i class="bi bi-receipt-cutoff" aria-hidden="true"></i></span>
                    <div>
                        <div class="nx-receipt-brand-name">NEXORA</div>
                        <div class="nx-receipt-brand-subtitle">Sistema de gestión comercial y facturación</div>
                    </div>
                </div>
                <div class="nx-receipt-identity">
                    <div class="nx-receipt-document-type">Comprobante de venta</div>
                    <div class="nx-receipt-reference">@Model.NumeroFactura</div>
                    <div class="nx-receipt-document-note">Documento interno · No fiscal</div>
                </div>
            </div>

            <div class="nx-receipt-separator"></div>

            <div class="nx-receipt-info-grid">
                <section class="nx-receipt-info-block">
                    <h2>Facturado a</h2>
                    <div class="nx-receipt-person">@(Model.Cliente == null ? "Cliente no disponible" : $"{Model.Cliente.Nombre} {Model.Cliente.Apellido}")</div>
                    <div class="nx-receipt-info-line"><span>Teléfono</span><span>@(Model.Cliente?.Telefono ?? "No registrado")</span></div>
                    <div class="nx-receipt-info-line"><span>Correo</span><span class="nx-receipt-break">@(Model.Cliente?.Correo ?? "No registrado")</span></div>
                    <div class="nx-receipt-info-line"><span>Dirección</span><span class="nx-receipt-break">@(Model.Cliente?.Direccion ?? "No registrada")</span></div>
                </section>

                <section class="nx-receipt-info-block">
                    <h2>Datos de la operación</h2>
                    <div class="nx-receipt-info-line"><span>Fecha</span><strong>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    <div class="nx-receipt-info-line"><span>Plazo interno de anulación</span><span>@fechaLimiteAnulacion.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="nx-receipt-info-line">
                        <span>Estado</span>
                        <strong class="nx-receipt-state @(anulada ? "is-void" : "is-issued")">
                            @(anulada ? "Anulada" : Model.Estado)
                        </strong>
                    </div>
                    <div class="nx-receipt-info-line"><span>Pago</span><strong>@(pago?.MetodoPago ?? "No registrado")</strong></div>
                    @if (pago != null)
                    {
                        <div class="nx-receipt-info-line"><span>Monto registrado</span><strong class="nx-receipt-money">RD$ @pago.Monto.ToString("N2")</strong></div>
                    }
                </section>
            </div>

            @if (anulada)
            {
                <div class="nx-receipt-void" role="status">
                    <i class="bi bi-exclamation-octagon me-2" aria-hidden="true"></i>
                    FACTURA ANULADA — Este comprobante ya no representa una venta vigente.
                </div>
            }

            <section class="nx-receipt-items" aria-label="Productos facturados">
                <h2>Detalle de productos</h2>
                <div class="table-responsive">
                    <table class="table nx-receipt-table">
                        <thead>
                            <tr>
                                <th scope="col">Producto y garantía</th>
                                <th scope="col" class="text-center">Cant.</th>
                                <th scope="col" class="text-end">Precio unitario</th>
                                <th scope="col" class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Model.Detalles)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @(detalle.Producto?.Nombre ?? "Producto no disponible")
                                        @if (detalle.GarantiaMeses > 0)
                                        {
                                            <span class="nx-receipt-warranty is-covered">
                                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                                Garantía: <strong>@detalle.GarantiaMeses meses</strong>
                                                <span class="nx-receipt-warranty-expiry">
                                                    Vence: @Model.Fecha.AddMonths(detalle.GarantiaMeses).ToString("dd/MM/yyyy")
                                                </span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="nx-receipt-warranty is-unspecified">
                                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                                Garantía comercial no registrada en esta factura
                                            </span>
                                        }
                                        @if (!anulada)
                                        {
                                            <a asp-controller="Posventa" asp-action="Create"
                                               asp-route-detalleId="@detalle.IdDetalle"
                                               class="nx-receipt-after-sale no-print">
                                                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>
                                                Solicitar devolución o garantía
                                            </a>
                                        }
                                    </td>
                                    <td class="text-center nx-receipt-money">@detalle.Cantidad</td>
                                    <td class="text-end nx-receipt-money">RD$ @detalle.Precio.ToString("N2")</td>
                                    <td class="text-end nx-receipt-money fw-semibold">RD$ @detalle.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <div class="nx-receipt-bottom">
                <div class="nx-receipt-note">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <div>
                        <strong>Información del comprobante</strong>
                        <p>Este documento corresponde al registro interno de la venta en Nexora. No constituye un comprobante fiscal.</p>
                    </div>
                </div>
                <section class="nx-receipt-totals" aria-label="Totales de la factura">
                    <div class="nx-receipt-total-row"><span>Subtotal</span><strong>RD$ @Model.Subtotal.ToString("N2")</strong></div>
                    <div class="nx-receipt-total-row"><span>ITBIS</span><strong>RD$ @Model.Impuesto.ToString("N2")</strong></div>
                    <div class="nx-receipt-total-row"><span>Descuento</span><strong>- RD$ @Model.Descuento.ToString("N2")</strong></div>
                    <div class="nx-receipt-grand-total">
                        <span>Total <small>RD$</small></span>
                        <strong>@Model.Total.ToString("N2")</strong>
                    </div>
                </section>
            </div>

            <div class="nx-receipt-footer">
                <strong>¡Gracias por su compra!</strong>
                <span>Nexora · Gestión comercial</span>
            </div>
        </div>
    </article>
</div>


@if (puedeAnular)
{
    <div class="modal fade nx-void-modal no-print" id="nxVoidInvoiceModal"
         tabindex="-1" aria-labelledby="nxVoidInvoiceTitle"
         aria-describedby="nxVoidInvoiceDescription">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="nx-void-modal-header">
                    <div class="nx-void-modal-icon" aria-hidden="true">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="nx-void-modal-heading">
                        <span class="nx-void-modal-eyebrow">Operación sensible</span>
                        <h2 class="modal-title" id="nxVoidInvoiceTitle">Confirmar anulación</h2>
                        <p>Factura <strong>@Model.NumeroFactura</strong></p>
                    </div>
                    <button type="button" class="btn-close nx-void-modal-close"
                            data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body nx-void-modal-body">
                    <p class="nx-void-modal-description" id="nxVoidInvoiceDescription">
                        Revisa los datos de la venta antes de continuar. Si confirmas,
                        la factura quedará <strong>Anulada</strong> y las unidades vendidas
                        regresarán al inventario.
                    </p>

                    <div class="nx-void-modal-summary" aria-label="Resumen de la factura">
                        <div class="nx-void-modal-summary-item">
                            <span><i class="bi bi-person me-1" aria-hidden="true"></i> Cliente</span>
                            <strong>@nombreCliente</strong>
                        </div>
                        <div class="nx-void-modal-summary-item">
                            <span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i> Fecha de venta</span>
                            <strong>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        <div class="nx-void-modal-summary-item">
                            <span><i class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></i> Unidades a restituir</span>
                            <strong>@unidadesPorRestaurar unidad(es) <small>en @lineasFactura línea(s)</small></strong>
                        </div>
                        <div class="nx-void-modal-summary-item nx-void-modal-summary-total">
                            <span>Total de la factura</span>
                            <strong>RD$ @Model.Total.ToString("N2")</strong>
                        </div>
                    </div>

                    <div class="nx-void-modal-warning" role="note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div>
                            <strong>Antes de confirmar</strong>
                            <p>Esta acción afecta al historial y al stock. No genera
                                automáticamente un reembolso ni una nota de crédito.
                                El plazo interno de anulación es de 7 días.</p>
                        </div>
                    </div>
                </div>

                <form asp-controller="Facturas" asp-action="Anular"
                      asp-route-id="@Model.IdFactura" method="post"
                      id="nxVoidInvoiceForm" class="nx-void-modal-footer"
                      asp-antiforgery="true">
                    <button type="button" class="btn nx-void-modal-cancel"
                            data-bs-dismiss="modal">
                        Mantener factura
                    </button>
                    <button type="submit" class="btn btn-danger nx-void-modal-confirm"
                            id="nxVoidInvoiceConfirm">
                        <i class="bi bi-check2-circle me-2" aria-hidden="true"></i>
                        Sí, anular factura
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("nxVoidInvoiceForm");
            const confirmButton = document.getElementById("nxVoidInvoiceConfirm");
            if (!form || !confirmButton) return;

            let submitting = false;
            form.addEventListener("submit", (event) => {
                if (submitting) {
                    event.preventDefault();
                    return;
                }
                submitting = true;
                confirmButton.disabled = true;
                confirmButton.setAttribute("aria-disabled", "true");
                confirmButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Anulando...';
            });
        })();
    </script>
}
