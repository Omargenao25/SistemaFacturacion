@model IEnumerable<SistemaFacturacion.Models.Factura>

@{
    ViewData["Title"] = "Historial de Facturas";
}


<div class="container mt-4">


    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Historial de Facturas
            </h2>

            <p class="text-muted mb-0">
                Consulta las facturas registradas en el sistema.
            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            + Nueva Factura

        </a>

    </div>



    <!-- FILTROS -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="Index">

                <div class="row g-3">


                    <!-- BUSCADOR -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Buscar
                        </label>

                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Factura o cliente..." />

                    </div>



                    <!-- ESTADO -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Estado
                        </label>

                        <select name="estado"
                                class="form-select">

                            <option value="Todos"
                                    selected="@(ViewBag.Estado == null ||
                                                ViewBag.Estado == "Todos")">

                                Todos

                            </option>

                            <option value="Emitida"
                                    selected="@(ViewBag.Estado == "Emitida")">

                                Emitida

                            </option>

                            <option value="Anulada"
                                    selected="@(ViewBag.Estado == "Anulada")">

                                Anulada

                            </option>

                        </select>

                    </div>



                    <!-- DESDE -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Desde
                        </label>

                        <input type="date"
                               name="desde"
                               value="@ViewBag.Desde"
                               class="form-control" />

                    </div>



                    <!-- HASTA -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Hasta
                        </label>

                        <input type="date"
                               name="hasta"
                               value="@ViewBag.Hasta"
                               class="form-control" />

                    </div>



                    <!-- BOTÓN BUSCAR -->
                    <div class="col-md-2
                                d-flex
                                align-items-end">

                        <button type="submit"
                                class="btn btn-dark w-100">

                            Buscar

                        </button>

                    </div>

                </div>


                <div class="mt-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar filtros

                    </a>

                </div>

            </form>

        </div>

    </div>



    <!-- CANTIDAD DE RESULTADOS -->
    <div class="mb-3">

        <strong>
            Resultados:
        </strong>

        @Model.Count()

    </div>



    <!-- TABLA -->
    <div class="card shadow-sm">

        <div class="card-body">


            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">

                    No se encontraron facturas
                    con los filtros seleccionados.

                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table
                                  table-striped
                                  table-hover
                                  align-middle">


                        <thead class="table-dark">

                            <tr>

                                <th>
                                    Factura
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th class="text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            @foreach (var factura in Model)
                            {

                                <tr>


                                    <!-- NÚMERO -->
                                    <td>

                                        <strong>
                                            @factura.NumeroFactura
                                        </strong>

                                    </td>



                                    <!-- CLIENTE -->
                                    <td>

                                        @factura.Cliente?.Nombre
                                        @factura.Cliente?.Apellido

                                    </td>



                                    <!-- FECHA -->
                                    <td>

                                        @factura.Fecha.ToString(
                                                 "dd/MM/yyyy HH:mm"
                                                 )

                                    </td>



                                    <!-- TOTAL -->
                                    <td class="fw-bold">

                                        RD$
                                        @factura.Total.ToString("N2")

                                    </td>



                                    <!-- ESTADO -->
                                    <td>

                                        @if (factura.Estado == "Emitida")
                                        {
                                            <span class="badge bg-success">

                                                Emitida

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                Anulada

                                            </span>
                                        }

                                    </td>



                                    <!-- ACCIONES -->
                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@factura.IdFactura"
                                           class="btn
                                                  btn-sm
                                                  btn-outline-primary">

                                            Ver

                                        </a>

                                    </td>


                                </tr>

                            }


                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>