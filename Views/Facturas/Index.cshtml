@model IEnumerable<SistemaFacturacion.Models.Factura>
@{
    ViewData["Title"] = "Historial de facturas";
    var estado = ViewBag.Estado as string ?? "Todos";
    var buscar = ViewBag.Buscar as string ?? "";
    var desde = ViewBag.Desde as string ?? "";
    var hasta = ViewBag.Hasta as string ?? "";
    var conFiltros = !string.IsNullOrWhiteSpace(buscar) || estado != "Todos" || !string.IsNullOrWhiteSpace(desde) || !string.IsNullOrWhiteSpace(hasta);
}
<div class="nx-history-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Operaciones</div>
            <h1 class="page-title">Historial de facturas</h1>
            <p class="page-subtitle">Consulta los comprobantes registrados y encuentra una venta por cliente, estado o fecha.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nueva factura
        </a>
    </div>

    <section class="nx-panel mb-4" aria-labelledby="nx-history-filter-title">
        <div class="nx-panel-header">
            <h2 id="nx-history-filter-title" class="nx-panel-title">
                <i class="bi bi-funnel me-2 text-primary" aria-hidden="true"></i>Filtros de búsqueda
            </h2>
            @if (conFiltros)
            {
                <a asp-action="Index" class="nx-action"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Limpiar filtros</a>
            }
        </div>
        <div class="nx-filters-body">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 col-md-6">
                        <label for="nxBuscarFactura" class="form-label">Número o cliente</label>
                        <div class="nx-search-control">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input id="nxBuscarFactura" type="search" name="buscar" value="@buscar" class="form-control"
                                   placeholder="Ej. FAC-2026 o nombre..." />
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="nxEstadoFactura" class="form-label">Estado</label>
                        <select id="nxEstadoFactura" name="estado" class="form-select">
                            <option value="Todos" selected="@(estado == "Todos")">Todos</option>
                            <option value="Emitida" selected="@(estado == "Emitida")">Emitida</option>
                            <option value="Anulada" selected="@(estado == "Anulada")">Anulada</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="nxDesdeFactura" class="form-label">Desde</label>
                        <input id="nxDesdeFactura" type="date" name="desde" value="@desde" class="form-control" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="nxHastaFactura" class="form-label">Hasta</label>
                        <input id="nxHastaFactura" type="date" name="hasta" value="@hasta" class="form-control" />
                    </div>
                    <div class="col-lg-2 col-md-12">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1" aria-hidden="true"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="nx-panel" aria-labelledby="nx-history-results-title">
        <div class="nx-panel-header">
            <div>
                <h2 id="nx-history-results-title" class="nx-panel-title">Facturas registradas</h2>
                <p class="nx-panel-subtitle">Selecciona un comprobante para ver su detalle o imprimirlo.</p>
            </div>
            <span class="nx-count-pill">@Model.Count() resultado(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="nx-empty">
                <i class="bi bi-file-earmark-search" aria-hidden="true"></i>
                <strong>No se encontraron facturas.</strong>
                <p class="mb-0">Prueba otro intervalo de fechas, estado o nombre de cliente.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover nx-table nx-history-table">
                    <thead>
                        <tr>
                            <th scope="col">Número</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Fecha</th>
                            <th scope="col" class="text-end">Importe</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in Model)
                        {
                            <tr>
                                <td><span class="nx-invoice-code">@factura.NumeroFactura</span></td>
                                <td class="fw-semibold">@(factura.Cliente == null ? "Cliente no disponible" : $"{factura.Cliente.Nombre} {factura.Cliente.Apellido}")</td>
                                <td class="nx-history-date">@factura.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end nx-mono fw-semibold">RD$ @factura.Total.ToString("N2")</td>
                                <td>
                                    <span class="nx-status @(factura.Estado == "Emitida" ? "good" : "danger")">
                                        <i class="bi @(factura.Estado == "Emitida" ? "bi-check-circle" : "bi-x-circle") me-1" aria-hidden="true"></i>
                                        @factura.Estado
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@factura.IdFactura"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i> Ver detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
