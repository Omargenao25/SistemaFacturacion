@model IEnumerable<SistemaFacturacion.Models.Factura>

@{
    ViewData["Title"] = "Historial de Facturas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Historial de Facturas</h2>

        <a asp-action="Create"
           class="btn btn-primary">

            + Nueva Factura

        </a>

    </div>

    <table class="table table-striped table-bordered">

        <thead class="table-dark">

            <tr>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var factura in Model)
            {
                <tr>

                    <td>
                        @factura.NumeroFactura
                    </td>

                    <td>
                        @factura.Cliente?.Nombre
                        @factura.Cliente?.Apellido
                    </td>

                    <td>
                        @factura.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        RD$ @factura.Total.ToString("N2")
                    </td>

                    <td>

                        @if (factura.Estado == "Emitida")
                        {
                            <span class="badge bg-success">
                                Emitida
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Anulada
                            </span>
                        }

                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@factura.IdFactura"
                           class="btn btn-info btn-sm">

                            Ver

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>