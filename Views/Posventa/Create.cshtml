@model SistemaFacturacion.ViewModels.CrearCasoPosventaViewModel
@{
    ViewData["Title"] = "Nueva solicitud de posventa";
    var vence = Model.FechaVenta.AddMonths(Model.GarantiaMeses);
}
<div class="nx-crud-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Posventa</div>
            <h1 class="page-title">Nueva solicitud</h1>
            <p class="page-subtitle">Registra una devolución o reclamación de garantía sin alterar la factura original.</p>
        </div>
        <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Historial de facturas
        </a>
    </div>

    <div class="nx-crud-shell">
        <section class="nx-panel" aria-labelledby="nx-posventa-heading">
            <div class="nx-panel-header">
                <div class="nx-crud-heading">
                    <span class="nx-crud-heading-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="nx-posventa-heading" class="nx-panel-title">Registrar caso</h2>
                        <p class="nx-panel-subtitle">Solicitud pendiente de revisión. No se realizará ningún reembolso automático.</p>
                    </div>
                </div>
            </div>
            <form asp-action="Create" method="post" class="nx-crud-form">
                <input asp-for="IdDetalle" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6"><strong>Factura</strong><div class="text-muted">@Model.NumeroFactura</div></div>
                    <div class="col-md-6"><strong>Producto</strong><div class="text-muted">@Model.NombreProducto</div></div>
                    <div class="col-md-6"><strong>Unidades vendidas</strong><div class="text-muted">@Model.CantidadVendida</div></div>
                    <div class="col-md-6"><strong>Compra</strong><div class="text-muted">@Model.FechaVenta.ToString("dd/MM/yyyy")</div></div>
                </div>
                @if (Model.GarantiaMeses > 0)
                {
                    <div class="alert alert-info" role="status">
                        <i class="bi bi-shield-check me-2" aria-hidden="true"></i>
                        Garantía comercial registrada: <strong>@Model.GarantiaMeses meses</strong>.
                        Vencimiento previsto: <strong>@vence.ToString("dd/MM/yyyy")</strong>.
                        @if (DateTime.Now > vence)
                        {
                            <span class="d-block mt-1">Este plazo comercial ya venció. Aun así, puedes registrar un caso para revisión.</span>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary" role="status">
                        No hay garantía comercial registrada en esta factura. Puedes solicitar una revisión;
                        esto no determina los derechos legales del consumidor.
                    </div>
                }
                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="Tipo" class="form-label">Tipo de solicitud</label>
                        <select asp-for="Tipo" class="form-select" required>
                            <option value="Garantia">Reclamación de garantía</option>
                            <option value="Devolucion">Solicitud de devolución</option>
                        </select>
                        <span asp-validation-for="Tipo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Cantidad" class="form-label">Unidades involucradas</label>
                        <input asp-for="Cantidad" class="form-control" type="number"
                               min="1" max="@Model.CantidadVendida" required />
                        <span asp-validation-for="Cantidad" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Motivo" class="form-label">Descripción del problema</label>
                        <textarea asp-for="Motivo" class="form-control" rows="5" maxlength="800"
                                  minlength="10" required
                                  placeholder="Explica qué ocurrió con el producto y cuál es la solicitud del cliente."></textarea>
                        <span asp-validation-for="Motivo" class="text-danger small"></span>
                    </div>
                </div>
                <div class="alert alert-light border mt-4 small">
                    Una solicitud no equivale a una devolución aprobada, reparación realizada ni dinero reembolsado.
                    El inventario y los pagos permanecen intactos hasta que se implemente un proceso autorizado.
                </div>
                <div class="nx-crud-actions">
                    <a asp-controller="Facturas" asp-action="Details"
                       asp-route-id="@ViewBag.IdFactura" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i> Registrar solicitud
                    </button>
                </div>
            </form>
        </section>
        <aside class="nx-crud-sidebar">
            <span class="nx-crud-sidebar-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
            <h3>Atención posventa</h3>
            <p>Las solicitudes se verifican individualmente. El límite interno de 7 días para anular una factura
               no impide presentar una devolución o reclamación que corresponda atender.</p>
        </aside>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
