@model SistemaFacturacion.Models.Producto
@{
    ViewData["Title"] = "Nuevo producto";
}
<div class="nx-crud-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Productos</div>
            <h1 class="page-title">Nuevo producto</h1>
            <p class="page-subtitle">Registra el catálogo, define precios y controla las existencias.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Volver a productos</a>
    </div>

    <div class="nx-crud-shell">
        <section class="nx-panel" aria-labelledby="nx-crud-heading">
            <div class="nx-panel-header">
                <div class="nx-crud-heading">
                    <span class="nx-crud-heading-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="nx-panel-title" id="nx-crud-heading">Información del producto</h2>
                        <p class="nx-panel-subtitle">Los campos con * son obligatorios.</p>
                    </div>
                </div>
            </div>
            <form asp-action="Create" method="post" class="nx-crud-form">
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-4">
                    <div class="col-md-4"><label asp-for="Codigo" class="form-label">Código / SKU <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Codigo" class="form-control" type="text" maxlength="30" placeholder="Ej. PROD-001" required /><span asp-validation-for="Codigo" class="text-danger small"></span></div>
                <div class="col-md-8"><label asp-for="Nombre" class="form-label">Nombre del producto <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Nombre" class="form-control" type="text" maxlength="100" placeholder="Ej. Teclado mecánico" required /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="200" placeholder="Descripción del artículo"></textarea><span asp-validation-for="Descripcion" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="IdCategoria" class="form-label">Categoría <span class="text-danger" aria-hidden="true">*</span></label><select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select" required><option value="">Selecciona una categoría...</option></select><div class="nx-crud-helper">¿No aparece una categoría? <a asp-controller="Categorias" asp-action="Create">Crear categoría</a>.</div><span asp-validation-for="IdCategoria" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Stock" class="form-label">Unidades disponibles</label><input asp-for="Stock" class="form-control" type="number" min="0" step="1" /><span asp-validation-for="Stock" class="text-danger small"></span><div class="nx-crud-helper">Si registras 0 unidades, Nexora lo mostrará como Agotado y no permitirá facturarlo. Cuando agregues existencias, la disponibilidad se actualizará automáticamente.</div></div>
                <div class="col-md-6"><label asp-for="GarantiaMeses" class="form-label">Garantía comercial (meses)</label><input asp-for="GarantiaMeses" class="form-control" type="number" min="0" max="120" step="1" /><span asp-validation-for="GarantiaMeses" class="text-danger small"></span><div class="nx-crud-helper">Ej.: 6, 12, 24. Usa 0 si no se ha registrado una garantía adicional. No sustituye las garantías legales aplicables.</div></div>
                <div class="col-md-6"><label asp-for="Precio" class="form-label">Precio de venta (RD$)</label><input asp-for="Precio" class="form-control" type="number" min="0" step=".01" /><span asp-validation-for="Precio" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Costo" class="form-label">Costo unitario (RD$)</label><input asp-for="Costo" class="form-control" type="number" min="0" step=".01" /><span asp-validation-for="Costo" class="text-danger small"></span></div>
                <div class="col-12"><div class="nx-crud-toggle form-check form-switch"><input class="form-check-input" asp-for="Estado" role="switch" /><label class="form-check-label" asp-for="Estado">Producto activo (control manual)</label></div><span class="text-danger small" asp-validation-for="Estado"></span><div class="nx-crud-helper">Si lo desactivas manualmente, no volverá a estar disponible al reponer stock hasta que lo actives.</div></div>
                </div>
                <div class="nx-crud-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i> Guardar registro</button>
                </div>
            </form>
        </section>
        <aside class="nx-crud-sidebar">
            <span class="nx-crud-sidebar-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
            <h3>Consejo de Nexora</h3>
            <p>Verifica que el precio, costo, categoría y stock correspondan al artículo. Solo los productos activos con existencias estarán disponibles para facturar.</p>
        </aside>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
