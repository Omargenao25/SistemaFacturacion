@model SistemaFacturacion.Models.Producto
@{
    ViewData["Title"] = "Detalle de producto";
}

<div class="nx-crud-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Productos / Detalle</div>
            <h1 class="page-title">Detalle de producto</h1>
            <p class="page-subtitle">Consulta la información registrada en el sistema.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Volver a productos
        </a>
    </div>
    <div class="nx-crud-shell">
        <section class="nx-panel" aria-labelledby="nx-detail-title">
            <div class="nx-panel-header">
                <div class="nx-crud-heading">
                    <span class="nx-crud-heading-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                    <div>
                        <h2 class="nx-panel-title" id="nx-detail-title">@Model.Nombre</h2>
                        <p class="nx-panel-subtitle">Información del registro</p>
                    </div>
                </div>
                
            </div>

            

            <dl class="nx-detail-grid">
                <div class="nx-detail-row"><dt>Código / SKU</dt><dd>@Model.Codigo</dd></div>
                    <div class="nx-detail-row"><dt>Nombre</dt><dd>@Model.Nombre</dd></div>
                    <div class="nx-detail-row"><dt>Descripción</dt><dd>@(Model.Descripcion ?? "Sin descripción")</dd></div>
                    <div class="nx-detail-row"><dt>Categoría</dt><dd>@(Model.Categoria?.Nombre ?? $"Categoría #{Model.IdCategoria}")</dd></div>
                    <div class="nx-detail-row"><dt>Precio de venta</dt><dd>RD$ @Model.Precio.ToString("N2")</dd></div>
                    <div class="nx-detail-row"><dt>Costo unitario</dt><dd>RD$ @Model.Costo.ToString("N2")</dd></div>
                    <div class="nx-detail-row"><dt>Existencias</dt><dd>@Model.Stock unidades</dd></div>
                    <div class="nx-detail-row"><dt>Estado del inventario (automático)</dt><dd><span class="nx-status @Model.ClaseEstadoInventario">@Model.EstadoInventario</span></dd></div>
                    <div class="nx-detail-row"><dt>Disponibilidad para facturar</dt><dd><span class="nx-status @Model.ClaseDisponibilidadVenta">@Model.DisponibilidadVenta</span></dd></div>
                    <div class="nx-detail-row"><dt>Garantía comercial</dt><dd>@(Model.GarantiaMeses > 0 ? $"{Model.GarantiaMeses} meses" : "No registrada")</dd></div>
                    <div class="nx-detail-row"><dt>Control manual</dt><dd><span class="nx-status @(Model.Estado ? "good" : "danger")">@(Model.Estado ? "Activo" : "Inactivo")</span></dd></div>
            </dl>

            <div class="nx-detail-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Regresar</a>
                <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Editar producto
                </a>
            </div>
        </section>
        <aside class="nx-crud-sidebar">
            <span class="nx-crud-sidebar-icon">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
            </span>
            <h3>Información del registro</h3>
            <p>Con 0 unidades, el producto aparece como <strong>Agotado</strong> y no se puede facturar. Al reponerlo, vuelve a estar disponible si está activo manualmente.</p>
        </aside>
    </div>
</div>
