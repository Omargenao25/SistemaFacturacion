@model IEnumerable<SistemaFacturacion.Models.Producto>
@{ ViewData["Title"] = "Productos"; }
<div class="page-intro">
    <div><div class="page-eyebrow">Nexora / Inventario</div><h1 class="page-title">Productos</h1><p class="page-subtitle">Controla precios, costos, existencias y disponibilidad de tus productos.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Nuevo producto</a>
</div>
<section class="nx-panel">
    <div class="nx-panel-header"><h2 class="nx-panel-title">Catálogo de productos</h2><span class="text-muted small">@Model.Count() registros</span></div>
    @if(!Model.Any()) {
        <div class="nx-empty"><i class="bi bi-box-seam"></i>No hay productos registrados.</div>
    } else {
        <div class="table-responsive"><table class="table table-hover nx-table">
            <thead><tr><th>Código</th><th>Producto</th><th>Precio</th><th>Costo</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach(var item in Model) {
                <tr>
                    <td class="fw-semibold">@item.Codigo</td><td><div class="fw-semibold">@item.Nombre</div><small class="text-muted">@item.Descripcion</small></td>
                    <td class="nx-mono">RD$ @item.Precio.ToString("N2")</td><td class="nx-mono">RD$ @item.Costo.ToString("N2")</td>
                    <td><span class="nx-status @(item.Stock == 0 ? "danger" : item.Stock <= 5 ? "warn" : "good")">@item.Stock</span></td>
                    <td><span class="nx-status @(item.Estado ? "good" : "danger")">@(item.Estado ? "Activo" : "Inactivo")</span></td>
                    <td>
                        <a class="nx-list-action" asp-action="Details" asp-route-id="@item.IdProducto">Ver</a>
                        <a class="nx-list-action" asp-action="Edit" asp-route-id="@item.IdProducto">Editar</a>
                        <a class="nx-list-action text-danger" asp-action="Delete" asp-route-id="@item.IdProducto">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>