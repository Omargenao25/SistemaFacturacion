@model IEnumerable<SistemaFacturacion.Models.Factura>
@using SistemaFacturacion.Models
@using SistemaFacturacion.ViewModels
@{
    ViewData["Title"] = "Reportes";
    var masVendidos = ViewBag.ProductosMasVendidos as List<ProductoVendidoReporteViewModel> ?? new();
    var bajoStock = ViewBag.ProductosBajoStock as List<Producto> ?? new();
}
<div class="nx-reports-page">
    <div class="page-intro">
        <div>
            <div class="page-eyebrow">Nexora / Analítica</div>
            <h1 class="page-title">Reportes comerciales</h1>
            <p class="page-subtitle">Consulta las ventas emitidas, identifica productos destacados y revisa alertas de inventario.</p>
        </div>
    </div>

    <section class="nx-panel mb-4" aria-labelledby="nx-reports-period-title">
        <div class="nx-panel-header">
            <h2 class="nx-panel-title" id="nx-reports-period-title">
                <i class="bi bi-calendar3 me-2 text-primary" aria-hidden="true"></i>Período de consulta
            </h2>
            <span class="text-muted small">Las ventas se filtran por fecha de emisión.</span>
        </div>
        <div class="nx-filters-body">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="nxReportDesde" class="form-label">Fecha inicial</label>
                        <input id="nxReportDesde" type="date" name="desde" value="@ViewBag.Desde" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label for="nxReportHasta" class="form-label">Fecha final</label>
                        <input id="nxReportHasta" type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Actualizar reporte
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6"><div class="nx-stat-card">
            <div class="nx-stat-heading"><span>Venta total</span><span class="nx-stat-icon"><i class="bi bi-currency-exchange"></i></span></div>
            <div class="nx-stat-value nx-mono">RD$ @(((decimal)ViewBag.TotalVentas).ToString("N2"))</div>
            <div class="nx-stat-foot">Facturas emitidas del período</div>
        </div></div>
        <div class="col-xl-3 col-sm-6"><div class="nx-stat-card">
            <div class="nx-stat-heading"><span>Facturas emitidas</span><span class="nx-stat-icon"><i class="bi bi-receipt"></i></span></div>
            <div class="nx-stat-value nx-mono">@ViewBag.TotalFacturas</div>
            <div class="nx-stat-foot">Excluye facturas anuladas</div>
        </div></div>
        <div class="col-xl-3 col-sm-6"><div class="nx-stat-card">
            <div class="nx-stat-heading"><span>ITBIS calculado</span><span class="nx-stat-icon"><i class="bi bi-percent"></i></span></div>
            <div class="nx-stat-value nx-mono">RD$ @(((decimal)ViewBag.TotalImpuestos).ToString("N2"))</div>
            <div class="nx-stat-foot">Según las facturas registradas</div>
        </div></div>
        <div class="col-xl-3 col-sm-6"><div class="nx-stat-card">
            <div class="nx-stat-heading"><span>Descuentos</span><span class="nx-stat-icon"><i class="bi bi-tag"></i></span></div>
            <div class="nx-stat-value nx-mono">RD$ @(((decimal)ViewBag.TotalDescuentos).ToString("N2"))</div>
            <div class="nx-stat-foot">Descuentos concedidos</div>
        </div></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <section class="nx-finance-card">
                <div class="nx-finance-icon"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i></div>
                <div>
                    <div class="nx-finance-label">Costo de productos vendidos</div>
                    <div class="nx-finance-number nx-mono">RD$ @(((decimal)ViewBag.CostoTotal).ToString("N2"))</div>
                    <div class="nx-finance-caption">Costo unitario registrado al emitir la factura.</div>
                </div>
            </section>
        </div>
        <div class="col-lg-6">
            <section class="nx-finance-card nx-finance-accent">
                <div class="nx-finance-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div>
                <div>
                    <div class="nx-finance-label">Margen bruto estimado*</div>
                    <div class="nx-finance-number nx-mono">RD$ @(((decimal)ViewBag.GananciaBruta).ToString("N2"))</div>
                    <div class="nx-finance-caption">Ventas antes de impuestos menos costo de artículos.</div>
                </div>
            </section>
        </div>
    </div>
    <p class="nx-report-disclaimer mb-4">
        *Estimación académica: no resta descuentos ni gastos operativos. Las facturas históricas sin costo unitario registrado pueden alterar el resultado.
    </p>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <section class="nx-panel h-100">
                <div class="nx-panel-header">
                    <div>
                        <h2 class="nx-panel-title">Productos más vendidos</h2>
                        <p class="nx-panel-subtitle">Cinco artículos con más unidades vendidas en el período.</p>
                    </div>
                    <i class="bi bi-trophy text-primary nx-report-header-icon" aria-hidden="true"></i>
                </div>
                @if (!masVendidos.Any())
                {
                    <div class="nx-empty"><i class="bi bi-bag-x" aria-hidden="true"></i>No se registraron ventas en este período.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover nx-table">
                            <thead><tr><th scope="col">#</th><th scope="col">Producto</th><th scope="col" class="text-center">Unidades</th><th scope="col" class="text-end">Importe</th></tr></thead>
                            <tbody>
                                @{ int posicion = 1; }
                                @foreach (var producto in masVendidos)
                                {
                                    <tr>
                                        <td><span class="nx-rank">@posicion</span></td>
                                        <td class="fw-semibold">@producto.Nombre</td>
                                        <td class="text-center nx-mono">@producto.CantidadVendida</td>
                                        <td class="text-end nx-mono">RD$ @producto.TotalVendido.ToString("N2")</td>
                                    </tr>
                                    posicion++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
        <div class="col-xl-5">
            <section class="nx-panel h-100">
                <div class="nx-panel-header">
                    <div>
                        <h2 class="nx-panel-title">Inventario bajo</h2>
                        <p class="nx-panel-subtitle">Existencias actuales (5 unidades o menos).</p>
                    </div>
                    <i class="bi bi-exclamation-triangle text-warning nx-report-header-icon" aria-hidden="true"></i>
                </div>
                @if (!bajoStock.Any())
                {
                    <div class="nx-empty"><i class="bi bi-check-circle" aria-hidden="true"></i>No hay alertas de inventario.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover nx-table">
                            <thead><tr><th scope="col">Producto</th><th scope="col">Categoría</th><th scope="col" class="text-center">Stock</th></tr></thead>
                            <tbody>
                                @foreach (var producto in bajoStock)
                                {
                                    <tr>
                                        <td class="fw-semibold">@producto.Nombre</td>
                                        <td>@(producto.Categoria?.Nombre ?? "Sin categoría")</td>
                                        <td class="text-center">
                                            <span class="nx-status @(producto.Stock == 0 ? "danger" : "warn")">
                                                @(producto.Stock == 0 ? "Agotado" : producto.Stock.ToString())
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>

    <section class="nx-panel" aria-labelledby="nx-reports-invoices-title">
        <div class="nx-panel-header">
            <div>
                <h2 class="nx-panel-title" id="nx-reports-invoices-title">Detalle de ventas</h2>
                <p class="nx-panel-subtitle">Solo incluye facturas emitidas en el período seleccionado.</p>
            </div>
            <span class="nx-count-pill">@Model.Count() factura(s)</span>
        </div>
        @if (!Model.Any())
        {
            <div class="nx-empty"><i class="bi bi-receipt" aria-hidden="true"></i>Sin facturas para las fechas elegidas.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover nx-table nx-report-invoices">
                    <thead>
                        <tr>
                            <th scope="col">Factura</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Cliente</th>
                            <th scope="col" class="text-end">Subtotal</th>
                            <th scope="col" class="text-end">ITBIS</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col" class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in Model)
                        {
                            <tr>
                                <td><span class="nx-invoice-code">@factura.NumeroFactura</span></td>
                                <td>@factura.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(factura.Cliente == null ? "Cliente no disponible" : $"{factura.Cliente.Nombre} {factura.Cliente.Apellido}")</td>
                                <td class="text-end nx-mono">RD$ @factura.Subtotal.ToString("N2")</td>
                                <td class="text-end nx-mono">RD$ @factura.Impuesto.ToString("N2")</td>
                                <td class="text-end nx-mono fw-bold">RD$ @factura.Total.ToString("N2")</td>
                                <td class="text-end">
                                    <a asp-controller="Facturas" asp-action="Details" asp-route-id="@factura.IdFactura"
                                       class="btn btn-outline-primary btn-sm"><i class="bi bi-eye me-1" aria-hidden="true"></i>Ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
