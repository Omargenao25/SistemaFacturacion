@model IEnumerable<SistemaFacturacion.Models.Factura>

@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-4">

    <h2 class="fw-bold">
        Reporte de Ventas
    </h2>

    <p class="text-muted">
        Consulta las ventas realizadas por período.
    </p>

    <form method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">

            <label class="form-label">
                Desde
            </label>

            <input type="date"
                   name="desde"
                   value="@ViewBag.Desde"
                   class="form-control" />

        </div>


        <div class="col-md-4">

            <label class="form-label">
                Hasta
            </label>

            <input type="date"
                   name="hasta"
                   value="@ViewBag.Hasta"
                   class="form-control" />

        </div>


        <div class="col-md-4 d-flex align-items-end">

            <button class="btn btn-primary w-100">
                Consultar
            </button>

        </div>

    </form>


    <div class="row g-3 mb-4">


        <div class="col-md-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Total vendido
                    </small>

                    <h4>
                        RD$ @(((decimal)ViewBag.TotalVentas).ToString("N2"))
                    </h4>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Facturas
                    </small>

                    <h4>
                        @ViewBag.TotalFacturas
                    </h4>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        ITBIS generado
                    </small>

                    <h4>
                        RD$ @(((decimal)ViewBag.TotalImpuestos).ToString("N2"))
                    </h4>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Descuentos
                    </small>

                    <h4>
                        RD$ @(((decimal)ViewBag.TotalDescuentos).ToString("N2"))
                    </h4>

                </div>

            </div>

        </div>


    </div>


    <table class="table table-striped table-bordered">

        <thead class="table-dark">

            <tr>
                <th>Factura</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Subtotal</th>
                <th>ITBIS</th>
                <th>Total</th>
                <th></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var factura in Model)
            {
                <tr>

                    <td>
                        @factura.NumeroFactura
                    </td>

                    <td>
                        @factura.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @factura.Cliente?.Nombre
                        @factura.Cliente?.Apellido
                    </td>

                    <td>
                        RD$ @factura.Subtotal.ToString("N2")
                    </td>

                    <td>
                        RD$ @factura.Impuesto.ToString("N2")
                    </td>

                    <td class="fw-bold">
                        RD$ @factura.Total.ToString("N2")
                    </td>

                    <td>

                        <a asp-controller="Facturas"
                           asp-action="Details"
                           asp-route-id="@factura.IdFactura"
                           class="btn btn-sm btn-outline-primary">

                            Ver

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>