@using SistemaFacturacion.Security
@using Microsoft.Extensions.Configuration
@inject SistemaFacturacion.Services.Tenancy.ContextoEmpresaVerificado EquipoEmpresaActual
@inject Microsoft.Extensions.Configuration.IConfiguration NexoraConfig
@{
    var modoEmpresarial = NexoraConfig.GetValue<bool>("Seguridad:ActivarTenancyValidada");
    var empresaSeleccionada = modoEmpresarial && EquipoEmpresaActual.TieneEmpresa;
    var slugEmpresaActual = empresaSeleccionada
        ? ViewContext.RouteData.Values["empresaSlug"]?.ToString()
        : null;
    var mostrarModulos = !modoEmpresarial || empresaSeleccionada;
    Func<string, bool> puede = permiso =>
        !modoEmpresarial || (empresaSeleccionada &&
            PermisosNexora.TienePermiso(EquipoEmpresaActual.RolEmpresa, permiso));
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Nexora
    </title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SistemaFacturacion.styles.css"
          asp-append-version="true" />

</head>


<body>

    <div class="app-wrapper">


        <!-- SIDEBAR -->
        <aside class="sidebar no-print" id="nexoraSidebar">

            <div class="sidebar-brand">

                <div class="brand-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <h5 class="mb-0">
                        Nexora
                    </h5>

                    <small>
                        Gestión comercial
                    </small>
                </div>

            </div>


            <nav class="sidebar-menu">

                @if (modoEmpresarial)
                {
                    <a href="/mis-empresas"
                       class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "EmpresasAcceso" ? "active" : "")">
                        <i class="bi bi-buildings" aria-hidden="true"></i>
                        <span>Mis empresas</span>
                    </a>
                }

                @if (mostrarModulos)
                {
                @if (puede(PermisosNexora.ConsultarOperaciones))
                {
                <a asp-controller="Home"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">

                    <i class="bi bi-grid"></i>

                    <span>
                        Dashboard
                    </span>

                </a>
                }


                <div class="menu-title">
                    GESTIÓN
                </div>


                @if (puede(PermisosNexora.ConsultarOperaciones))
                {
                <a asp-controller="Clientes"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")">

                    <i class="bi bi-people"></i>

                    <span>
                        Clientes
                    </span>

                </a>
                }


                @if (puede(PermisosNexora.ConsultarOperaciones))
                {
                <a asp-controller="Categorias"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categorias" ? "active" : "")">

                    <i class="bi bi-tags"></i>

                    <span>
                        Categorías
                    </span>

                </a>
                }


                @if (puede(PermisosNexora.ConsultarOperaciones))
                {
                <a asp-controller="Productos"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        Productos
                    </span>

                </a>
                }


                <div class="menu-title">
                    OPERACIONES
                </div>


                @if (puede(PermisosNexora.CrearFacturas))
                {
                <a asp-controller="Facturas"
                   asp-action="Create" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturas" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Nueva factura
                    </span>

                </a>
                }


                @if (puede(PermisosNexora.ConsultarOperaciones))
                {
                <a asp-controller="Facturas"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturas" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">

                    <i class="bi bi-receipt-cutoff"></i>

                    <span>
                        Historial
                    </span>

                </a>
                }


                @if (puede(PermisosNexora.ConsultarPosventa))
                {
                <a asp-controller="Posventa"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posventa" ? "active" : "")">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Atención posventa</span>
                </a>
                }

                @if (puede(PermisosNexora.ConsultarRecepciones))
                {
                <a asp-controller="Recepciones"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recepciones" ? "active" : "")">
                    <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                    <span>Recepciones</span>
                </a>
                }

                @if (puede(PermisosNexora.ConsultarReembolsos))
                {
                <a asp-controller="ControlAnulaciones"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ControlAnulaciones" ? "active" : "")">
                    <i class="bi bi-clipboard-data" aria-hidden="true"></i>
                    <span>Control de anulaciones</span>
                </a>
                }

                @if (puede(PermisosNexora.ConsultarReportes))
                {
                <a asp-controller="Reportes"
                   asp-action="Index" asp-route-empresaSlug="@slugEmpresaActual"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        Reportes
                    </span>

                </a>
                }


                @if (EquipoEmpresaActual.TieneEmpresa &&
                     PermisosNexora.TienePermiso(
                         EquipoEmpresaActual.RolEmpresa, PermisosNexora.AdministrarUsuarios))
                {
                    <div class="menu-title">ADMINISTRACIÓN</div>
                    <a asp-controller="Equipo"
                       asp-action="Index"
                       asp-route-empresaSlug="@slugEmpresaActual"
                       class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipo" ? "active" : "")">
                        <i class="bi bi-person-gear" aria-hidden="true"></i>
                        <span>Mi equipo</span>
                    </a>
                }
                }

            </nav>

        </aside>



        <!-- CONTENIDO PRINCIPAL -->
        <div class="mobile-nav-backdrop no-print" id="mobileNavBackdrop"></div>
        <div class="main-wrapper">


            <!-- TOPBAR -->
            <header class="topbar no-print">

                <div>

                    <button class="sidebar-toggle"
                            id="sidebarToggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="nexoraSidebar">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <div class="topbar-right">
                    @if (mostrarModulos)
                    {
                        @if (puede(PermisosNexora.CrearFacturas))
                {
                <a asp-controller="Facturas" asp-action="Create" asp-route-empresaSlug="@slugEmpresaActual"
                           class="btn btn-primary btn-sm topbar-action">
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nueva factura
                        </a>
                }
                    }

                    <div class="system-status">

                        <span class="status-dot"></span>

                        @(modoEmpresarial && !empresaSeleccionada ? "Selecciona empresa" : "Sistema activo")

                    </div>


                    <div class="user-area">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </header>



            <!-- PAGE CONTENT -->
            <main class="main-content">

                @RenderBody()

            </main>


            <!-- FOOTER -->
            <footer class="app-footer no-print">

                <span>
                    © @DateTime.Now.Year Nexora
                </span>

                <span>
                    Sistema de Facturación
                </span>

            </footer>


        </div>

    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <script>

        const toggle = document.getElementById("sidebarToggle");
        const sidebar = document.getElementById("nexoraSidebar");
        const backdrop = document.getElementById("mobileNavBackdrop");

        function closeSidebar() {
            sidebar?.classList.remove("sidebar-open");
            backdrop?.classList.remove("visible");
            toggle?.setAttribute("aria-expanded", "false");
        }

        toggle?.addEventListener("click", () => {
            const opening = !sidebar.classList.contains("sidebar-open");
            sidebar.classList.toggle("sidebar-open", opening);
            backdrop?.classList.toggle("visible", opening);
            toggle.setAttribute("aria-expanded", opening.toString());
        });

        backdrop?.addEventListener("click", closeSidebar);
        document.addEventListener("keydown", event => {
            if (event.key === "Escape") closeSidebar();
        });
        sidebar?.querySelectorAll("a").forEach(link => link.addEventListener("click", closeSidebar));
        window.addEventListener("resize", () => {
            if (window.innerWidth > 991) closeSidebar();
        });

    </script>


    @await RenderSectionAsync(
            "Scripts",
            required: false
            )

</body>

</html>